---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/layout.css';
import '../styles/components.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Evan Yoon | Pressing 'Restart' on Life",
  description = "Former HR specialist (Josun Palace), Former GM (Blizzard) who decided to trade a stable career for code. Evan Yoon's journey."
} = Astro.props;

const email = import.meta.env.EMAIL_ADDRESS ?? "wlgus1805@gmail.com";
const contactHref = email ? `mailto:${email}` : "/#about";
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,700;1,9..144,300&family=Geologica:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body class="fade-in">

  <Nav />

  <!-- Search modal — markup kept here because the search script below references
       these IDs directly. Extract together in a later phase. -->
  <div id="search-overlay" aria-hidden="true">
    <div id="search-modal" role="dialog" aria-label="Search posts">
      <div id="search-header">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="search-icon-inline">
          <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input id="search-input" type="text" placeholder="제목, 태그, 카테고리로 검색하세요.." autocomplete="off" spellcheck="false" />
        <kbd id="search-esc-hint">ESC</kbd>
      </div>
      <div id="search-hint">
        <p class="sh-shortcut"><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>P</kbd> 로도 검색창을 열 수 있어요</p>
        <p class="sh-easter">🌨 다크 모드에서 <code>blizzard</code> 를 입력해 보세요</p>
      </div>
      <div id="search-results"></div>
      <div id="search-footer">
        <span><kbd>↑</kbd><kbd>↓</kbd> 이동</span>
        <span><kbd>Enter</kbd> 선택</span>
        <span><kbd>ESC</kbd> 닫기</span>
      </div>
    </div>
  </div>

  <main>
    <slot />
  </main>

  <Footer contactHref={contactHref} />

  <div id="scroll-navigation" class="scroll-nav">
    <button id="scroll-top" aria-label="Scroll to top" title="Go to Top">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
    </button>
    <button id="scroll-bottom" aria-label="Scroll to bottom" title="Go to Bottom">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </button>
  </div>

  <script is:inline data-goatcounter="https://evan-yoon.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>

  <!-- ─── SEARCH ──────────────────────────────────────────────────────────── -->
  <script is:inline>
    (function () {
      let posts = null;
      let active = -1;

      const overlay = document.getElementById('search-overlay');
      const input = document.getElementById('search-input');
      const results = document.getElementById('search-results');
      const hint = document.getElementById('search-hint');
      const toggleBtn = document.getElementById('search-toggle');

      async function loadPosts() {
        if (posts) return;
        try {
          const res = await fetch('/search.json');
          posts = await res.json();
        } catch (e) {
          posts = [];
        }
      }

      function open() {
        overlay.classList.add('open');
        overlay.setAttribute('aria-hidden', 'false');
        input.value = '';
        results.innerHTML = '';
        active = -1;
        if (hint) hint.style.display = '';
        loadPosts().then(() => input.focus());
      }

      function close() {
        overlay.classList.remove('open');
        overlay.setAttribute('aria-hidden', 'true');
        input.blur();
      }

      function highlight(text, query) {
        if (!query) return text;
        const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return text.replace(new RegExp(`(${escaped})`, 'gi'), '<mark>$1</mark>');
      }

      function search(query) {
        if (!posts || !query.trim()) {
          results.innerHTML = '';
          active = -1;
          if (hint) hint.style.display = '';
          return;
        }
        if (hint) hint.style.display = 'none';

        const q = query.toLowerCase().trim();
        const matched = posts.filter((p) => {
          const inTitle = p.title.toLowerCase().includes(q);
          const inDesc = (p.description || '').toLowerCase().includes(q);
          const inTags = (p.tags || []).some((t) => t.toLowerCase().includes(q));
          const inCat = (p.category || '').toLowerCase().includes(q);
          return inTitle || inDesc || inTags || inCat;
        }).slice(0, 8);

        if (matched.length === 0) {
          results.innerHTML = '<div class="sr-empty">검색 결과가 없습니다.</div>';
          active = -1;
          return;
        }

        results.innerHTML = matched.map((p, i) => {
          const catClass = 'badge-' + (p.category || 'explore');
          const desc = p.description
            ? highlight(p.description.slice(0, 90) + (p.description.length > 90 ? '...' : ''), q)
            : '';
          return `<a class="sr-item" href="/posts/${p.slug}" data-index="${i}" tabindex="-1">
            <div class="sr-top">
              <span class="sr-title">${highlight(p.title, q)}</span>
              <span class="sr-meta">
                <span class="sr-cat ${catClass}">${p.category}</span>
                <span class="sr-date">${p.date}</span>
              </span>
            </div>
            ${desc ? `<p class="sr-desc">${desc}</p>` : ''}
          </a>`;
        }).join('');

        active = -1;
      }

      function setActive(idx) {
        const items = results.querySelectorAll('.sr-item');
        items.forEach((el) => el.classList.remove('active'));
        if (idx >= 0 && idx < items.length) {
          items[idx].classList.add('active');
          items[idx].scrollIntoView({ block: 'nearest' });
          active = idx;
        } else {
          active = -1;
        }
      }

      toggleBtn.addEventListener('click', open);
      overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
      input.addEventListener('input', () => search(input.value));

      input.addEventListener('keydown', (e) => {
        const items = results.querySelectorAll('.sr-item');
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          setActive(Math.min(active + 1, items.length - 1));
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          setActive(Math.max(active - 1, 0));
        } else if (e.key === 'Enter') {
          if (active >= 0 && items[active]) {
            close();
            window.location.href = items[active].href;
          }
        } else if (e.key === 'Escape') {
          close();
        }
      });

      results.addEventListener('click', (e) => {
        const item = e.target.closest('.sr-item');
        if (item) close();
      });

      results.addEventListener('mousemove', (e) => {
        const item = e.target.closest('.sr-item');
        if (item) setActive(parseInt(item.dataset.index, 10));
      });

      document.addEventListener('keydown', (e) => {
        if (e.ctrlKey && e.shiftKey && e.key === 'P') {
          e.preventDefault();
          overlay.classList.contains('open') ? close() : open();
        }
        if (e.key === 'Escape' && overlay.classList.contains('open')) close();
      });
    })();
  </script>

  <!-- ─── THEME TOGGLE ─────────────────────────────────────────────────────── -->
  <script is:inline>
    const toggle = document.getElementById('theme-toggle');
    const saved = localStorage.getItem('theme') || 'light';
    document.documentElement.dataset.theme = saved;
    toggle.textContent = saved === 'dark' ? '☀️' : '🌙';
    toggle.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      toggle.textContent = next === 'dark' ? '☀️' : '🌙';
    });
  </script>

  <!-- ─── POST VIEW COUNTS (GoatCounter) ──────────────────────────────────── -->
  <script is:inline>
    (function () {
      const site = 'https://evan-yoon.goatcounter.com';
      const selector = '[data-post-views]';
      const cache = new Map();

      function waitForGoatCounter(maxAttempts = 40, interval = 250) {
        return new Promise((resolve) => {
          let attempts = 0;

          const timer = setInterval(() => {
            attempts += 1;

            if (window.goatcounter?.get_data) {
              clearInterval(timer);
              resolve(true);
              return;
            }

            if (attempts >= maxAttempts) {
              clearInterval(timer);
              resolve(false);
            }
          }, interval);
        });
      }

      async function fetchCountForPath(path) {
        try {
          const response = await fetch(`${site}/counter/${encodeURIComponent(path)}.json`);

          if (response.status === 404) return 0;
          if (!response.ok) throw new Error(`Failed to load count for ${path}: ${response.status}`);

          const data = await response.json();
          return Number(data?.count ?? 0);
        } catch (error) {
          console.error('[GoatCounter] count fetch error:', error);
          return 0;
        }
      }

      async function loadCount(path) {
        const cacheKey = (path || '').trim() || '/';
        if (cache.has(cacheKey)) return cache.get(cacheKey);

        const request = fetchCountForPath(cacheKey).catch(() => 0);
        cache.set(cacheKey, request);
        return request;
      }

      async function renderCounts() {
        const nodes = Array.from(document.querySelectorAll(selector));
        if (nodes.length === 0) return;

        const ready = await waitForGoatCounter();
        if (!ready || !window.goatcounter?.get_data) {
          for (const node of nodes) {
            node.textContent = 'views 0';
          }
          return;
        }

        const trackedPath = window.goatcounter.get_data()['p'];
        if (!trackedPath) {
          for (const node of nodes) {
            node.textContent = 'views 0';
          }
          return;
        }

        const count = await loadCount(trackedPath);

        for (const node of nodes) {
          node.textContent = `views ${count.toLocaleString('ko-KR')}`;
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderCounts);
      } else {
        renderCounts();
      }
    })();
  </script>

  <!-- ─── SCROLL NAVIGATION ────────────────────────────────────────────────── -->
  <script is:inline>
    (function() {
      const topBtn = document.getElementById('scroll-top');
      const bottomBtn = document.getElementById('scroll-bottom');

      if (topBtn) {
        topBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      if (bottomBtn) {
        bottomBtn.addEventListener('click', () => {
          window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
        });
      }
    })();
  </script>

  <!-- ─── BLIZZARD EASTER EGG ──────────────────────────────────────────────── -->
  <script is:inline>
    (function() {
      let snowing = false;
      const input = document.getElementById('search-input');
      const overlay = document.getElementById('search-overlay');

      function startSnow() {
        if (snowing) return;
        snowing = true;

        const canvas = document.createElement('canvas');
        canvas.id = 'blizzard-canvas';
        Object.assign(canvas.style, {
          position: 'fixed',
          top: 0,
          left: 0,
          width: '100%',
          height: '100%',
          pointerEvents: 'none',
          zIndex: 10000,
        });
        document.body.appendChild(canvas);

        const ctx = canvas.getContext('2d');
        let w, h;
        const particles = [];

        function resize() {
          w = canvas.width = window.innerWidth;
          h = canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resize);
        resize();

        for (let i = 0; i < 150; i++) {
          particles.push({
            x: Math.random() * w,
            y: Math.random() * h,
            r: Math.random() * 2 + 0.5,
            d: Math.random() * Math.PI * 2,
            v: Math.random() * 1.5 + 0.5,
            s: Math.random() * 0.5 + 0.2
          });
        }

        function draw() {
          ctx.clearRect(0, 0, w, h);
          ctx.fillStyle = document.documentElement.dataset.theme === 'dark'
            ? 'rgba(255, 255, 255, 0.8)'
            : 'rgba(255, 255, 255, 0.9)';
          ctx.beginPath();
          for (const p of particles) {
            ctx.moveTo(p.x, p.y);
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2, true);
          }
          ctx.fill();
        }

        function update() {
          for (const p of particles) {
            p.y += p.v;
            p.x += Math.sin(p.d) * p.s;
            p.d += 0.01;
            if (p.y > h) {
              p.y = -5;
              p.x = Math.random() * w;
            }
            if (p.x > w) p.x = 0;
            if (p.x < 0) p.x = w;
          }
        }

        function loop() {
          draw();
          update();
          requestAnimationFrame(loop);
        }

        if (overlay) overlay.classList.remove('open');
        loop();
      }

      if (input) {
        input.addEventListener('input', (e) => {
          if (e.target.value.toLowerCase() === 'blizzard') {
            startSnow();
            input.value = '';
          }
        });
      }
    })();
  </script>

</body>
</html>
