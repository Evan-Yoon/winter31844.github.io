---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/ai-news.css';

function getEntrySlug(entry: { id: string; data: { slug?: string } }) {
  return entry.data.slug ?? entry.id.split('/').pop() ?? entry.id;
}

function isWeeklyNews(entry: { id: string; data: { slug?: string; category?: string; draft?: boolean } }) {
  return !entry.data.draft && entry.data.category === 'ai-news' && getEntrySlug(entry).includes('weekly-ai-news');
}

const allPosts = await getCollection('posts');
const sortedNews = allPosts
  .filter(post => isWeeklyNews(post))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---

<BaseLayout title="AI Weekly News Archive | Evan Yoon" description="Explore the history of weekly AI breakthroughs and insights.">
  <div class="news-archive-container fade-in-up">
    <header class="archive-header">
      <p class="archive-kicker">Archive</p>
      <h1 class="archive-title">Weekly AI News</h1>
      <p class="archive-desc">
        A curated history of AI developments, reasoning models, <br>
        and practical insights for the future of tech.
      </p>
    </header>

    <div class="archive-grid">
      {sortedNews.map((news) => (
        <article class="news-list-card">
          {news.data.thumbnail && (
            <a href={`/ai-news/${getEntrySlug(news)}`} class="news-thumb-wrap">
              <img
                src={news.data.thumbnail}
                alt={news.data.title}
                class="news-thumb"
                loading="lazy"
                referrerpolicy="no-referrer"
              />
            </a>
          )}
          <div class="news-card-meta">
            <span class="news-card-date">{news.data.date.toLocaleDateString('ko-KR')}</span>
            {news.data.tags && (
              <div class="news-card-tags">
                {news.data.tags.map(tag => <span class="news-tag">#{tag}</span>)}
              </div>
            )}
          </div>
          <h2 class="news-card-title">
            <a href={`/ai-news/${getEntrySlug(news)}`}>{news.data.title}</a>
          </h2>
          <p class="news-card-desc">{news.data.description}</p>
          <a href={`/ai-news/${getEntrySlug(news)}`} class="news-read-more">
            Read Full Summary <span class="arrow">→</span>
          </a>
        </article>
      ))}
    </div>

    {sortedNews.length === 0 && (
      <div class="archive-empty">
        <p>No AI news updates found yet. Check back soon.</p>
      </div>
    )}
  </div>
</BaseLayout>

